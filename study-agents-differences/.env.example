# Copy this file to `.env` and fill in the values you need.
# Never commit the real `.env` file or any real credentials.

# OpenAI (used when running with --provider openai)
openai_api_key=
openai_model_name=gpt-4o-mini

# Azure OpenAI (used when running with --provider azure, the default)
azure_endpoint=https://your-azure-endpoint
azure_deployment_name=gpt-4o-mini
azure_api_version=2024-10-21
azure_api_key=

# Tavily (web search tool used by all agents)
tavily_api_key=

# Open-source model fallback (used with --provider other)
open_source_model_name=watt-ai/watt-tool-70B

# Embeddings (used by the RAG agents)
embeddings_model_name=text-embedding-ada-002
embeddings_api_version=2023-05-15
local_embeddings_model_name=all-MiniLM-L6-v2

# Shared sampling temperature used by every agent (keeps benchmarks comparable)
temperature=0.0

# Metro de Lisboa API (used by the API agents' subway tools).
# Tokens are short-lived (~3600s). Get one at:
# https://api.metrolisboa.pt/store/apis/info?name=EstadoServicoML&version=1.0.1&provider=admin
METRO_API_TOKEN=
